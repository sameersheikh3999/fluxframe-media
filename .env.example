# ===========================================================================
# Fluxframe Media — environment variable reference
#
# This file is DOCUMENTATION. Nothing loads it.
#
# The files you actually copy are:
#     backend/.env.example        ->  backend/.env
#     frontend/.env.local.example ->  frontend/.env.local
#
# For Railway, set these in each service's Variables tab. Never commit a real
# value — .gitignore excludes every .env file except the *.example templates.
# ===========================================================================


# ---------------------------------------------------------------------------
# BACKEND  (Railway service: backend, root directory `backend`)
# ---------------------------------------------------------------------------

# --- required in production ---

# Railway: add a PostgreSQL service and reference it, which is the whole value:
#     DATABASE_URL=${{Postgres.DATABASE_URL}}
# Neon/Supabase/elsewhere: paste the connection string. Any of postgres://,
# postgresql:// or postgresql+asyncpg:// is accepted and normalised to the
# psycopg async driver.
# Leave EMPTY and the app still boots and serves the health checks — every
# database-backed feature reports itself unavailable. That is a supported mode,
# and it is what a first deploy looks like before you add Postgres.
DATABASE_URL=

# local | staging | production
# `production` refuses to boot without INTERNAL_API_SECRET, and refuses a
# wildcard CORS origin. Those are configuration bugs worth crashing over.
ENVIRONMENT=production

# Comma-separated browser origins allowed to call the API. Your Vercel or
# Railway frontend URL goes here. "*" is rejected in production.
FRONTEND_ORIGINS=https://your-frontend.up.railway.app

# Shared secret guarding /dashboard, /demo and /admin. Must match the frontend's
# INTERNAL_API_SECRET exactly. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_SECRET=

# --- optional: each absent credential disables one feature, cleanly ---

# HubSpot Private App token. Absent -> CRM syncs are marked `skipped` and
# everything else works. Run backend/scripts/hubspot_bootstrap.py once before
# enabling this, or every sync will fail on missing custom properties.
HUBSPOT_ACCESS_TOKEN=
# Default false: ten synthetic contacts per click would pollute a real portal.
HUBSPOT_SYNC_DEMO_LEADS=false

# Anthropic API key for AI sales briefs. Absent -> the endpoint returns a clear
# 503 and the dashboard says why. It never fabricates a brief.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NOTE=set AI_MODEL to override; default claude-sonnet-5
AI_MODEL=claude-sonnet-5

# --- optional: sensible defaults, override only if you need to ---

LOG_LEVEL=INFO
# json in production (Railway parses it), console locally.
LOG_FORMAT=json

# Regex for Vercel preview URLs, which cannot be enumerated. Leave empty if the
# frontend is on Railway.
#   ^https://your-project-[a-z0-9-]+\.vercel\.app$
FRONTEND_ORIGIN_REGEX=

# Alembic's connection. Leave empty to reuse DATABASE_URL (correct on Railway).
# On Neon, set this to the DIRECT (unpooled) endpoint: migrations through a
# transaction-mode pooler misbehave.
DATABASE_MIGRATION_URL=

ENABLE_DEMO_GENERATOR=true
DEMO_MAX_BATCH_SIZE=10

OUTBOX_DISPATCHER_ENABLED=true
OUTBOX_POLL_INTERVAL_SECONDS=5
OUTBOX_MAX_ATTEMPTS=6

# Per-instance, in-process. With two replicas the effective limit doubles.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60


# ---------------------------------------------------------------------------
# FRONTEND  (Railway service: frontend, root directory `frontend`)
#
# NEXT_PUBLIC_* is inlined into the browser bundle at BUILD time. On Railway set
# these as build variables, and remember that changing one requires a redeploy
# to take effect. A secret must NEVER carry that prefix.
# ---------------------------------------------------------------------------

# Public. The lead form posts here from the visitor's browser.
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
NEXT_PUBLIC_SITE_URL=https://your-frontend.up.railway.app

# Server-only. Read in Server Components, Route Handlers and middleware, which
# never ship to the browser. Must match the backend value above.
INTERNAL_API_SECRET=

# Optional HTTP basic auth over /dashboard and /demo. Set both in production.
DASHBOARD_BASIC_AUTH_USER=
DASHBOARD_BASIC_AUTH_PASSWORD=
