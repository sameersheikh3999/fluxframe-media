# ===========================================================================
# Fluxframe Media — environment variable reference
#
# This file is documentation. It is not loaded by anything.
# The files you actually copy are:
#
#     backend/.env.example        ->  backend/.env
#     frontend/.env.local.example ->  frontend/.env.local
#
# Nothing in this repository reads a .env file from the repository root.
# ===========================================================================

# ---------------------------------------------------------------------------
# BACKEND  (backend/.env)   — server-side only, never reaches a browser
# ---------------------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=console
FRONTEND_ORIGINS=http://localhost:3000
FRONTEND_ORIGIN_REGEX=

# ---------------------------------------------------------------------------
# FRONTEND  (frontend/.env.local)
#
# NEXT_PUBLIC_* is compiled into the JavaScript bundle and is readable by
# anyone who opens devtools. A secret must never carry that prefix.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# ADDED IN LATER PHASES — listed so you know what is coming, not yet read.
#
#   Phase 1  DATABASE_URL              Neon pooled endpoint, used at runtime
#            DATABASE_MIGRATION_URL    Neon direct endpoint, used by Alembic
#   Phase 2  INTERNAL_API_SECRET       guards the dashboard endpoints
#   Phase 3  HUBSPOT_ACCESS_TOKEN      HubSpot private app token
#            HUBSPOT_SYNC_DEMO_LEADS   default false; keeps demo data out of a real CRM
#   Phase 4  ENABLE_DEMO_GENERATOR     kill switch for the synthetic lead generator
#            DEMO_MAX_BATCH_SIZE       hard cap, default 10
#   Phase 5  OUTBOX_DISPATCHER_ENABLED background dispatcher on/off
# ---------------------------------------------------------------------------
