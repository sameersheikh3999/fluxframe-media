# ---------------------------------------------------------------------------
# Fluxframe Media — frontend configuration
#
#   cp .env.local.example .env.local
#
# NEXT_PUBLIC_* is compiled into the browser bundle. Anyone can read it.
# A variable WITHOUT that prefix is server-only: it is available inside Server
# Components, Route Handlers and middleware, and never reaches the browser.
# Secrets go in the second group. Always.
# ---------------------------------------------------------------------------

# Public — safe to expose.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public. The lead form posts directly here from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Server-only. NEVER give these a NEXT_PUBLIC_ prefix: that would compile them
# into the browser bundle, where anyone can read them.
#
# These are read only inside Server Components, Route Handlers and middleware,
# which never ship to the client.
# ---------------------------------------------------------------------------

# Must match INTERNAL_API_SECRET on the backend. Guards /dashboard and /demo.
INTERNAL_API_SECRET=

# Optional HTTP basic auth over /dashboard and /demo. Leave blank locally;
# set both in production.
DASHBOARD_BASIC_AUTH_USER=
DASHBOARD_BASIC_AUTH_PASSWORD=
