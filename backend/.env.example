# ---------------------------------------------------------------------------
# Fluxframe Media — backend configuration
#
#     cp .env.example .env      (Windows: copy .env.example .env)
#
# Every variable is read by app/config/settings.py and validated at STARTUP, so
# a bad value crashes the process on boot rather than 503-ing one request days
# later.
#
# The defaults below run the whole application locally with no database server,
# no accounts and no credentials.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=console

# SQLite for zero-setup local development: the schema is created automatically
# on startup, and no database server is needed.
#
# For PostgreSQL (Neon, Railway, local) use the real connection string and run
# `uv run alembic upgrade head` instead — migrations are how a schema change is
# reviewed and versioned, and auto-creation is deliberately SQLite-only.
#   DATABASE_URL=postgresql+psycopg://user:pass@host/dbname?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./fluxframe-dev.db

# Neon only: the DIRECT (unpooled) endpoint, for Alembic. Empty reuses the URL
# above, which is correct for Railway and for SQLite.
DATABASE_MIGRATION_URL=

# Browser origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:3000
FRONTEND_ORIGIN_REGEX=

# Guards /dashboard, /demo and /admin. Must match the frontend's value.
# Empty is allowed locally; production refuses to boot without it.
INTERNAL_API_SECRET=local-dev-secret

# --- HubSpot (optional) ----------------------------------------------------
# Absent: CRM syncs are marked `skipped` and everything else works.
# Run `uv run python scripts/hubspot_bootstrap.py` once before enabling.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_SYNC_DEMO_LEADS=false

# --- AI (optional) ---------------------------------------------------------
# Absent: the sales-brief endpoint returns a clear 503. It never invents one.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# --- demo generator --------------------------------------------------------
ENABLE_DEMO_GENERATOR=true
DEMO_MAX_BATCH_SIZE=10

# --- outbox dispatcher -----------------------------------------------------
OUTBOX_DISPATCHER_ENABLED=true
OUTBOX_POLL_INTERVAL_SECONDS=5
OUTBOX_MAX_ATTEMPTS=6

# --- rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
