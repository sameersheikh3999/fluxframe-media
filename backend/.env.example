# ---------------------------------------------------------------------------
# Fluxframe Media — backend configuration
#
#   cp .env.example .env
#
# Every variable here is read by app/config/settings.py and validated at
# startup. A bad value crashes the process on boot, not on request 4,000.
#
# Phase 0 has no required variables: the defaults below are enough to run.
# ---------------------------------------------------------------------------

# local | staging | production
ENVIRONMENT=local

# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# console = readable in your terminal.  json = one object per line, for Railway.
LOG_FORMAT=console

# Comma-separated list of browser origins allowed to call this API.
# In production this must list explicit origins. "*" is rejected at startup.
FRONTEND_ORIGINS=http://localhost:3000

# Vercel gives every preview deployment its own hostname, so previews cannot be
# enumerated. Leave empty locally. In production, something like:
#   ^https://fluxframe-media-[a-z0-9-]+\.vercel\.app$
FRONTEND_ORIGIN_REGEX=
